{
  "name": "kit-on-lambda",
  "version": "1.1.2",
  "description": "SvelteKit adapter for AWS Lambda for Node.js and Bun runtimes",
  "keywords": [
    "adapter",
    "aws",
    "bun",
    "cdk",
    "lambda",
    "nodejs",
    "svelte",
    "sveltekit"
  ],
  "license": "MIT",
  "author": {
    "name": "Ivan Barlog",
    "email": "ivan.barlog@beesolve.com"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/BeeSolve/kit-on-lambda.git"
  },
  "files": [
    "dist",
    "docs/how-to",
    "DOCS.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esb.d.ts",
      "import": "./dist/esb.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "import": "./dist/bun.js"
    },
    "./cdk": {
      "types": "./dist/cdk.d.ts",
      "import": "./dist/cdk.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "test": "bun test",
    "lint": "oxlint .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "oxfmt --check && oxlint .",
    "prepare": "husky",
    "prepublishOnly": "bun --bun run build.ts",
    "version": "changeset version",
    "release": "bun run prepublishOnly && changeset publish",
    "integ:deploy-test-destroy": "RUN_AWS_INTEG=1 bun test test/integration/deploy-destroy.test.ts",
    "integ:cleanup": "bash scripts/integ-cleanup.sh",
    "integ:local": "LOCAL_INTEG=1 bun test test/integration/local.test.ts"
  },
  "dependencies": {
    "@beesolve/lambda-bun-runtime": "^3.10402.1",
    "@beesolve/lambda-fetch-api": "^2.1.2",
    "@beesolve/lambda-function-url-protection": "^0.2.0",
    "@beesolve/lambda-keep-active": "^2.1.6"
  },
  "devDependencies": {
    "@beesolve/lint-config": "0.3.3",
    "@changesets/cli": "^3.0.3",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^3.0.1",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1"
  }
}
